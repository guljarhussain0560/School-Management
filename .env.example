# ==============================================================================
# Enterprise School Management System - Environment Configuration
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# NextAuth / Authentication
# ------------------------------------------------------------------------------
# Secret key used to encrypt/sign session tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=super-secret-nextauth-encryption-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL database connection URL (Prisma ORM)
DATABASE_URL="postgresql://school_user:school_password@localhost:5432/school_management?schema=public"

# ------------------------------------------------------------------------------
# Email / SMTP Service (Nodemailer)
# ------------------------------------------------------------------------------
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=notifications@schoolmanagement.example.com
EMAIL_SERVER_PASSWORD=your-app-specific-email-password
EMAIL_FROM="School Management System <no-reply@schoolmanagement.example.com>"

# ------------------------------------------------------------------------------
# Automated Test & Seeding Credentials
# ------------------------------------------------------------------------------
# Password used for integration test scripts and administrative test runs
TEST_PASSWORD=TestPassSecure2026!

# ------------------------------------------------------------------------------
# Observability, Structured Logging & Error Tracking
# ------------------------------------------------------------------------------
# Controls log level output (debug, info, warn, error)
LOG_LEVEL=info
# Enable structured telemetry error tracking (Sentry / custom error tracker)
ENABLE_ERROR_TRACKING=false
# Sentry DSN for remote error monitoring and telemetry capture
SENTRY_DSN=""

